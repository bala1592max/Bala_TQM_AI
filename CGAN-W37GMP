      "source": [
        "def discriminator_loss(real_output, fake_output):\n",
        "\n",
        "    real_loss = cross_entropy(\n",
        "        tf.ones_like(real_output),\n",
        "        real_output\n",
        "    )\n",
        "\n",
        "    fake_loss = cross_entropy(\n",
        "        tf.zeros_like(fake_output),\n",
        "        fake_output\n",
        "    )\n",
        "\n",
        "    return real_loss + fake_loss"
